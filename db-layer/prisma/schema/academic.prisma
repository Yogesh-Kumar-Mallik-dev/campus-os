// ==============================================================================
// academic_schema: Curriculum, Department Hosting, Timetables & Grading
// ==============================================================================

model Department {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  hodUserId       String?          @map("hod_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  retiredAt       DateTime?        @map("retired_at")
  hostedSemesters HostedSemester[]

  @@map("departments")
  @@schema("academic_schema")
}

model Course {
  id             String           @id @default(uuid())
  code           String           @unique
  name           String
  degreeLevel    String           @map("degree_level") // e.g. "UG", "PG", "DIPLOMA"
  totalSemesters Int              @map("total_semesters")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  retiredAt      DateTime?        @map("retired_at")
  semesters      Semester[]
  hostedSemesters HostedSemester[]

  @@map("courses")
  @@schema("academic_schema")
}

model Semester {
  id              String            @id @default(uuid())
  courseId        String            @map("course_id")
  semesterNumber  Int               @map("semester_number")
  totalCredits    Int               @default(0) @map("total_credits")
  createdAt       DateTime          @default(now()) @map("created_at")
  course          Course            @relation(fields: [courseId], references: [id])
  subjects        SemesterSubject[]
  labs            SemesterLab[]
  hostedSemesters HostedSemester[]

  @@unique([courseId, semesterNumber])
  @@map("semesters")
  @@schema("academic_schema")
}

model Subject {
  id           String               @id @default(uuid())
  code         String               @unique
  name         String
  credits      Int
  isElective   Boolean              @default(false) @map("is_elective")
  createdAt    DateTime             @default(now()) @map("created_at")
  retiredAt    DateTime?            @map("retired_at")
  semesters    SemesterSubject[]
  assignments  TeachingAssignment[]
  slots        TimetableSlot[]
  assessments  InternalAssessment[]

  @@map("subjects")
  @@schema("academic_schema")
}

model Lab {
  id          String               @id @default(uuid())
  code        String               @unique
  name        String
  capacity    Int
  roomNumber  String               @map("room_number")
  createdAt   DateTime             @default(now()) @map("created_at")
  retiredAt   DateTime?            @map("retired_at")
  semesters   SemesterLab[]
  assignments TeachingAssignment[]
  slots       TimetableSlot[]

  @@map("labs")
  @@schema("academic_schema")
}

model SemesterSubject {
  id         String   @id @default(uuid())
  semesterId String   @map("semester_id")
  subjectId  String   @map("subject_id")
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([semesterId, subjectId])
  @@map("semester_subjects")
  @@schema("academic_schema")
}

model SemesterLab {
  id         String   @id @default(uuid())
  semesterId String   @map("semester_id")
  labId      String   @map("lab_id")
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  lab        Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([semesterId, labId])
  @@map("semester_labs")
  @@schema("academic_schema")
}

model HostedSemester {
  id              String               @id @default(uuid())
  departmentId    String               @map("department_id")
  courseId        String               @map("course_id")
  semesterId      String               @map("semester_id")
  academicSession String               @map("academic_session") // e.g. "2026-2027-ODD"
  isActive        Boolean              @default(true) @map("is_active")
  createdAt       DateTime             @default(now()) @map("created_at")
  retiredAt       DateTime?            @map("retired_at")
  department      Department           @relation(fields: [departmentId], references: [id])
  course          Course               @relation(fields: [courseId], references: [id])
  semester        Semester             @relation(fields: [semesterId], references: [id])
  sections        Section[]
  assignments     TeachingAssignment[]
  assessments     InternalAssessment[]

  @@unique([departmentId, courseId, semesterId, academicSession])
  @@map("hosted_semesters")
  @@schema("academic_schema")
}

model Section {
  id               String               @id @default(uuid())
  hostedSemesterId String               @map("hosted_semester_id")
  code             String // e.g. "A", "B", "C"
  name             String // e.g. "Section A"
  capacity         Int                  @default(60)
  createdAt        DateTime             @default(now()) @map("created_at")
  hostedSemester   HostedSemester       @relation(fields: [hostedSemesterId], references: [id], onDelete: Cascade)
  slots            TimetableSlot[]
  assignments      TeachingAssignment[]
  assessments      InternalAssessment[]

  @@unique([hostedSemesterId, code])
  @@map("sections")
  @@schema("academic_schema")
}

model TimetableSlot {
  id            String   @id @default(uuid())
  sectionId     String   @map("section_id")
  dayOfWeek     Int      @map("day_of_week") // 1 = Monday ... 7 = Sunday
  periodNumber  Int      @map("period_number")
  startTime     String   @map("start_time") // "09:00"
  endTime       String   @map("end_time") // "09:50"
  subjectId     String?  @map("subject_id")
  labId         String?  @map("lab_id")
  teacherUserId String   @map("teacher_user_id")
  roomNumber    String   @map("room_number")
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject       Subject? @relation(fields: [subjectId], references: [id])
  lab           Lab?     @relation(fields: [labId], references: [id])

  @@map("timetable_slots")
  @@schema("academic_schema")
}

model TeachingAssignment {
  id               String         @id @default(uuid())
  hostedSemesterId String         @map("hosted_semester_id")
  sectionId        String         @map("section_id")
  subjectId        String?        @map("subject_id")
  labId            String?        @map("lab_id")
  teacherUserId    String         @map("teacher_user_id")
  isPrimary        Boolean        @default(true) @map("is_primary")
  createdAt        DateTime       @default(now()) @map("created_at")
  retiredAt        DateTime?      @map("retired_at")
  hostedSemester   HostedSemester @relation(fields: [hostedSemesterId], references: [id])
  section          Section        @relation(fields: [sectionId], references: [id])
  subject          Subject?       @relation(fields: [subjectId], references: [id])
  lab              Lab?           @relation(fields: [labId], references: [id])

  @@map("teaching_assignments")
  @@schema("academic_schema")
}

model InternalAssessment {
  id               String         @id @default(uuid())
  hostedSemesterId String         @map("hosted_semester_id")
  subjectId        String         @map("subject_id")
  sectionId        String         @map("section_id")
  name             String // e.g. "Mid-Term 1", "Assignment 2"
  maxMarks         Float          @map("max_marks")
  weightage        Float
  assessmentType   String         @map("assessment_type") // "THEORY", "PRACTICAL", "QUIZ"
  createdAt        DateTime       @default(now()) @map("created_at")
  hostedSemester   HostedSemester @relation(fields: [hostedSemesterId], references: [id])
  subject          Subject        @relation(fields: [subjectId], references: [id])
  section          Section        @relation(fields: [sectionId], references: [id])
  marks            StudentMark[]

  @@map("internal_assessments")
  @@schema("academic_schema")
}

model StudentMark {
  id                String             @id @default(uuid())
  assessmentId      String             @map("assessment_id")
  studentId         String             @map("student_id")
  marksObtained     Float?             @map("marks_obtained")
  isAbsent          Boolean            @default(false) @map("is_absent")
  submittedByUserId String             @map("submitted_by_user_id")
  status            String             @default("DRAFT") @map("status") // DRAFT, SUBMITTED, APPROVED, LOCKED
  approvedByUserId  String?            @map("approved_by_user_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  assessment        InternalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@map("student_marks")
  @@schema("academic_schema")
}

// ==============================================================================
// Affiliating University (AKTU) Semester Results, PDF Parsing & Revision Ledger
// ==============================================================================

model UniversityExamResult {
  id                    String                              @id @default(uuid())
  studentId             String                              @map("student_id")
  semesterNumber        Int                                 @map("semester_number")
  academicSession       String                              @map("academic_session") // e.g. "2024-25"
  examType              String                              @default("REGULAR") @map("exam_type") // REGULAR, BACK_PAPER, SPECIAL_COP, CHALLENGE_EVALUATION, SCRUTINY
  
  sgpa                  Float?
  cgpa                  Float?
  totalCreditsEarned    Float?                              @map("total_credits_earned")
  totalCreditsAttempted Float?                              @map("total_credits_attempted")
  totalMarksSecured     Float?                              @map("total_marks_secured")
  totalMaxMarks         Float?                              @map("total_max_marks")
  resultStatus          String                              @default("PASS") @map("result_status") // PASS, PWG (Pass With Grace), PCP (Promoted with Carry Over Paper), FAILED, YEAR_BACK
  
  verificationStatus    String                              @default("DRAFT_PARSED") @map("verification_status") // DRAFT_PARSED, VERIFIED_LOCKED, CONFLICT_RESOLUTION_NEEDED
  hasConflict           Boolean                             @default(false) @map("has_conflict")
  conflictDetails       Json?                               @map("conflict_details")
  
  currentRevisionId     String?                             @map("current_revision_id")
  createdAt             DateTime                            @default(now()) @map("created_at")
  updatedAt             DateTime                            @updatedAt @map("updated_at")
  
  revisions             UniversityExamResultRevision[]
  conflictResolutions   UniversityResultConflictResolution[]

  @@unique([studentId, semesterNumber, academicSession])
  @@index([studentId, resultStatus])
  @@index([verificationStatus])
  @@map("university_exam_results")
  @@schema("academic_schema")
}

model UniversityExamResultRevision {
  id               String                 @id @default(uuid())
  resultId         String                 @map("result_id")
  studentId        String                 @map("student_id")
  revisionNumber   Int                    @map("revision_number")
  examType         String                 @map("exam_type") // REGULAR, BACK_PAPER, SPECIAL_COP, CHALLENGE_EVALUATION_S1, CHALLENGE_EVALUATION_S2, SCRUTINY
  uploadSource     String                 @map("upload_source") // "INSTITUTION_BULK", "STUDENT_SELF", "MANUAL_OVERRIDE"
  documentId       String                 @map("document_id") // Reference to uploaded PDF in document_schema.documents
  uploadedByUserId String                 @map("uploaded_by_user_id")
  verifiedByUserId String?                @map("verified_by_user_id")
  
  sgpa             Float?
  cgpa             Float?
  resultStatus     String                 @map("result_status") // PASS, PWG, PCP, FAILED, YEAR_BACK
  deltaDetails     Json?                  @map("delta_details") // Snapshot diff of previous vs new marks/grades
  remarks          String?
  createdAt        DateTime               @default(now()) @map("created_at")
  
  result           UniversityExamResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subjectMarks     UniversitySubjectMark[]

  @@unique([resultId, revisionNumber])
  @@index([studentId, examType])
  @@index([documentId])
  @@map("university_exam_result_revisions")
  @@schema("academic_schema")
}

model UniversitySubjectMark {
  id             String                       @id @default(uuid())
  revisionId     String                       @map("revision_id")
  subjectCode    String                       @map("subject_code") // e.g. "KCS501"
  subjectName    String                       @map("subject_name") // e.g. "Database Management Systems"
  subjectType    String                       @default("THEORY") @map("subject_type") // THEORY, PRACTICAL
  
  internalMarks  Float?                       @map("internal_marks") // Sessional / College component
  externalMarks  Float?                       @map("external_marks") // University end-sem paper
  totalMarks     Float                        @map("total_marks")
  maxMarks       Float                        @default(100) @map("max_marks")
  
  grade          String? // e.g. "A+", "B", "F"
  gradePoints    Float?                       @map("grade_points")
  credits        Float                        @default(0)
  
  isGraceAwarded Boolean                      @default(false) @map("is_grace_awarded")
  graceMarks     Float                        @default(0) @map("grace_marks")
  
  isBackPaper    Boolean                      @default(false) @map("is_back_paper")
  attemptNumber  Int                          @default(1) @map("attempt_number")
  
  createdAt      DateTime                     @default(now()) @map("created_at")
  revision       UniversityExamResultRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, subjectCode])
  @@map("university_subject_marks")
  @@schema("academic_schema")
}

model UniversityResultConflictResolution {
  id                            String               @id @default(uuid())
  resultId                      String               @map("result_id")
  conflictedSubjectCode         String?              @map("conflicted_subject_code")
  studentUploadRevisionId       String               @map("student_upload_revision_id")
  institutionUploadRevisionId   String               @map("institution_upload_revision_id")
  status                        String               @default("PENDING") @map("status") // PENDING, RESOLVED_ACCEPTED_STUDENT, RESOLVED_ACCEPTED_INSTITUTION, RESOLVED_MANUALLY
  resolvedByUserId              String?              @map("resolved_by_user_id")
  resolutionJustification       String?              @map("resolution_justification")
  resolvedAt                    DateTime?            @map("resolved_at")
  createdAt                     DateTime             @default(now()) @map("created_at")
  
  result                        UniversityExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId, status])
  @@map("university_result_conflict_resolutions")
  @@schema("academic_schema")
}
