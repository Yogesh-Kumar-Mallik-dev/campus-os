// ==============================================================================
// auth_schema: Identity, Roles, Permissions & Scoped Assignments
// ==============================================================================

model User {
  id               String           @id @default(uuid())
  username         String           @unique
  email            String           @unique
  fullName         String           @map("full_name")
  phoneNumber      String?          @map("phone_number")
  passwordHash     String           @map("password_hash")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  retiredAt        DateTime?        @map("retired_at")
  assignments      RoleAssignment[]
  delegationsGiven Delegation[]     @relation("Delegator")
  delegationsRecv  Delegation[]     @relation("Delegate")
  superAdminSeats  SuperAdminSeat[]
  claimTokens      ClaimToken[]
  refreshTokens    RefreshToken[]

  @@map("users")
  @@schema("auth_schema")
}

model Role {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  description  String?
  isSystemRole Boolean          @default(false) @map("is_system_role")
  createdAt    DateTime         @default(now()) @map("created_at")
  retiredAt    DateTime?        @map("retired_at")
  permissions  RolePermission[]
  assignments  RoleAssignment[]
  delegations  Delegation[]

  @@map("roles")
  @@schema("auth_schema")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  domain      String
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
  @@schema("auth_schema")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
  @@schema("auth_schema")
}

model RoleAssignment {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  roleId      String            @map("role_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  retiredAt   DateTime?         @map("retired_at")
  retiredById String?           @map("retired_by_id")
  user        User              @relation(fields: [userId], references: [id])
  role        Role              @relation(fields: [roleId], references: [id])
  scopes      AssignmentScope[]

  @@map("role_assignments")
  @@schema("auth_schema")
}

model AssignmentScope {
  id           String         @id @default(uuid())
  assignmentId String         @map("assignment_id")
  dimension    String 
  value        String 
  createdAt    DateTime       @default(now()) @map("created_at")
  assignment   RoleAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, dimension, value])
  @@map("assignment_scopes")
  @@schema("auth_schema")
}

model Delegation {
  id              String    @id @default(uuid())
  delegatorUserId String    @map("delegator_user_id")
  delegateUserId  String    @map("delegate_user_id")
  roleId          String    @map("role_id")
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime  @map("ends_at")
  reason          String
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  delegator       User      @relation("Delegator", fields: [delegatorUserId], references: [id])
  delegate        User      @relation("Delegate", fields: [delegateUserId], references: [id])
  role            Role      @relation(fields: [roleId], references: [id])

  @@map("delegations")
  @@schema("auth_schema")
}

model SuperAdminSeat {
  id             String    @id @default("singleton")
  activeUserId   String    @map("active_user_id")
  crownedAt      DateTime  @default(now()) @map("crowned_at")
  retiredAt      DateTime? @map("retired_at")
  previousUserId String?   @map("previous_user_id")
  activeUser     User      @relation(fields: [activeUserId], references: [id])

  @@map("super_admin_seat")
  @@schema("auth_schema")
}

model ClaimToken {
  id              String    @id @default(uuid())
  tokenHash       String    @unique @map("token_hash")
  userId          String    @map("user_id")
  batchId         String?   @map("batch_id")
  targetRole      String    @map("target_role")
  status          String    @default("PENDING") @map("status") // PENDING, OTP_SENT, CLAIMED, EXPIRED, REVOKED
  otpChallengeId  String?   @map("otp_challenge_id")
  otpCodeHash     String?   @map("otp_code_hash")
  otpExpiresAt    DateTime? @map("otp_expires_at")
  expiresAt       DateTime  @map("expires_at")
  claimedAt       DateTime? @map("claimed_at")
  claimedFromIp   String?   @map("claimed_from_ip")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([tokenHash])
  @@map("claim_tokens")
  @@schema("auth_schema")
}

model RefreshToken {
  id            String    @id @default(uuid())
  tokenFamilyId String    @map("token_family_id")
  tokenHash     String    @unique @map("token_hash")
  userId        String    @map("user_id")
  isRevoked     Boolean   @default(false) @map("is_revoked")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([tokenFamilyId])
  @@map("refresh_tokens")
  @@schema("auth_schema")
}
