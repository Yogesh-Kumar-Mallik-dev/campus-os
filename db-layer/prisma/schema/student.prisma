// ==============================================================================
// student_schema: Student Demographics, Lateral Entry, Lifecycle & Time-Series Attendance
// ==============================================================================

model StudentProfile {
  id                    String                     @id @default(uuid())
  userId                String                     @unique @map("user_id")
  rollNumber            String                     @unique @map("roll_number")
  prn                   String                     @unique @map("prn")
  batchYear             String                     @map("batch_year")
  departmentId          String                     @map("department_id")
  currentSemesterNumber Int                        @default(1) @map("current_semester_number")
  
  admissionType         String                     @default("REGULAR") @map("admission_type") 
  entrySemesterNumber   Int                        @default(1) @map("entry_semester_number")  
  lateralEntryDetails   Json?                      @map("lateral_entry_details") 

  // Dual-Identity & Academic vs Legal Name Architecture
  academicName          String                     @map("academic_name") // Verbatim string as per Class X / Board Certificate (e.g. "Yogesh")
  legalFullName         String                     @map("legal_full_name") // Statutory legal name as per Aadhaar/Passport (e.g. "Yogesh Kumar Mallik")
  preferredName         String?                    @map("preferred_name") // Preferred daily display name


  fatherAcademicName    String?                    @map("father_academic_name") 
  fatherLegalName       String?                    @map("father_legal_name")  
  fatherPhoneNumber     String?                    @map("father_phone_number")
  fatherEmail           String?                    @map("father_email")
  fatherOccupation      String?                    @map("father_occupation")

  motherAcademicName    String?                    @map("mother_academic_name")
  motherLegalName       String?                    @map("mother_legal_name")
  motherPhoneNumber     String?                    @map("mother_phone_number")
  motherEmail           String?                    @map("mother_email")
  motherOccupation      String?                    @map("mother_occupation")

  guardianAcademicName  String?                    @map("guardian_academic_name") 
  guardianLegalName     String?                    @map("guardian_legal_name")
  guardianRelationship  String?                    @map("guardian_relationship")  
  guardianPhoneNumber   String?                    @map("guardian_phone_number")
  guardianEmail         String?                    @map("guardian_email")
  guardianAddress       String?                    @map("guardian_address")


  hasNameDiscrepancy            Boolean            @default(false) @map("has_name_discrepancy")
  nameDiscrepancyAffidavitDocId String?            @map("name_discrepancy_affidavit_doc_id") // 
  
  lifecycleState        String                     @default("APPLICANT") @map("lifecycle_state")
  dateOfBirth           DateTime?                  @map("date_of_birth")
  gender                String?
  emergencyContact      String?                    @map("emergency_contact")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  lifecycleHistory      StudentLifecycleHistory[]
  enrollments           StudentEnrollment[]
  sectionMemberships    StudentSectionMembership[]
  attendanceRecords     StudentAttendance[]

  @@index([departmentId, currentSemesterNumber])
  @@index([admissionType])
  @@index([academicName])
  @@index([legalFullName])
  @@map("student_profiles")
  @@schema("student_schema")
}

model StudentLifecycleHistory {
  id               String         @id @default(uuid())
  studentId        String         @map("student_id")
  fromState        String         @map("from_state")
  toState          String         @map("to_state")
  reason           String
  changedByUserId  String         @map("changed_by_user_id")
  evidenceDocId    String?        @map("evidence_doc_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("student_lifecycle_history")
  @@schema("student_schema")
}

model StudentEnrollment {
  id               String         @id @default(uuid())
  studentId        String         @map("student_id")
  courseId         String         @map("course_id")
  semesterId       String         @map("semester_id")
  academicSession  String         @map("academic_session")
  enrollmentStatus String         @default("ACTIVE") @map("enrollment_status") 
  createdAt        DateTime       @default(now()) @map("created_at")
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, semesterId, academicSession])
  @@index([studentId, academicSession])
  @@map("student_enrollments")
  @@schema("student_schema")
}

model StudentSectionMembership {
  id        String         @id @default(uuid())
  studentId String         @map("student_id")
  sectionId String         @map("section_id")
  isActive  Boolean        @default(true) @map("is_active")
  joinedAt  DateTime       @default(now()) @map("joined_at")
  leftAt    DateTime?      @map("left_at")
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([sectionId, isActive])
  @@map("student_section_memberships")
  @@schema("student_schema")
}

model StudentAttendance {
  id              String         @id @default(uuid())
  studentId       String         @map("student_id")
  timetableSlotId String         @map("timetable_slot_id")
  subjectId       String         @map("subject_id")
  sessionDate     DateTime       @map("session_date") 
  

  status          String         @default("PRESENT") @map("status")
  isExempted      Boolean        @default(false) @map("is_exempted")
  exemptionReason String?        @map("exemption_reason")
  remarks         String?
  
  markedByUserId  String         @map("marked_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

 
  @@unique([studentId, timetableSlotId, sessionDate])

  @@index([studentId, sessionDate])
  @@index([studentId, subjectId, sessionDate])
  @@index([sessionDate, timetableSlotId])
  @@map("student_attendance")
  @@schema("student_schema")
}
