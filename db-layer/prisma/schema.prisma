datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["auth_schema", "academic_schema", "student_schema", "hostel_schema", "audit_schema"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ==============================================================================
// auth_schema: Identity & Scoped Access
// ==============================================================================
model User {
  id           String           @id @default(uuid())
  email        String           @unique
  fullName     String           @map("full_name")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  retiredAt    DateTime?        @map("retired_at")
  assignments  RoleAssignment[]

  @@map("users")
  @@schema("auth_schema")
}

model Role {
  id           String           @id @default(uuid())
  code         String           @unique
  name         String
  description  String?
  assignments  RoleAssignment[]

  @@map("roles")
  @@schema("auth_schema")
}

model RoleAssignment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  user        User      @relation(fields: [userId], references: [id])
  role        Role      @relation(fields: [roleId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  retiredAt   DateTime? @map("retired_at")

  @@map("role_assignments")
  @@schema("auth_schema")
}

// ==============================================================================
// audit_schema: Immutable Logs & Break-Glass Records
// ==============================================================================
model AuditLog {
  id             String   @id @default(uuid())
  actorId        String   @map("actor_id")
  action         String
  targetResource String   @map("target_resource")
  payloadDiff    Json     @map("payload_diff")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
  @@schema("audit_schema")
}

model BreakGlassIncident {
  id           String    @id @default(uuid())
  developerId  String    @map("developer_id")
  reason       String
  targetScope  String    @map("target_scope")
  invokedAt    DateTime  @default(now()) @map("invoked_at")
  terminatedAt DateTime? @map("terminated_at")
  isFrozen     Boolean   @default(true) @map("is_frozen")

  @@map("break_glass_incidents")
  @@schema("audit_schema")
}
