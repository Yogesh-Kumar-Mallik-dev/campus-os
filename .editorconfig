root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.proto]
indent_style = space
indent_size = 2

[*.svelte]
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
